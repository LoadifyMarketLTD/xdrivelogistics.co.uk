# Supabase Auth is the single source of truth.
# Create users and roles in Supabase Auth / database tables.

# Supabase Configuration
# Get these from your Supabase project settings at https://app.supabase.com
NEXT_PUBLIC_SITE_URL=https://www.xdrivelogistics.co.uk
XDRIVE_FORCE_CANONICAL_HOST=false
NEXT_PUBLIC_SUPABASE_URL=https://jqxlauexhkonixtjvljw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPECTED_NEXT_PUBLIC_SUPABASE_URL=https://jqxlauexhkonixtjvljw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Legacy fallback still accepted server-side: SUPABASE_SERVICE_KEY
RESEND_API_KEY=your_resend_api_key
SEND_EMAIL_HOOK_SECRET=your_send_email_hook_secret
XDRIVE_NOTIFICATION_WEBHOOK_SECRET=your_notification_webhook_secret
SITE_URL=https://www.xdrivelogistics.co.uk
FROM_EMAIL=no-reply@xdrivelogistics.co.uk
# Optional: if unset, /api/public/quote-request falls back to the oldest company row.
XDRIVE_DEFAULT_COMPANY_ID=your_default_company_uuid

# Stripe — SERVER-ONLY. Never expose these values through NEXT_PUBLIC_* variables.
# Platform memberships are charged to XDrive Logistics Ltd.
# Transport invoices use Stripe Connect direct charges to the supplier's Standard connected account.
STRIPE_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Must remain false/unset until Stripe Tax / VAT handling is reviewed and configured for Production.
STRIPE_TAX_ENABLED=false
# Recurring monthly GBP Prices for the canonical XDrive plans. Prices are configured in Stripe; IDs only live here.
STRIPE_PRICE_OWNER_DRIVER=
STRIPE_PRICE_CUSTOMER_SHIPPER=
STRIPE_PRICE_SMALL_CARRIER=
STRIPE_PRICE_BROKER=
STRIPE_PRICE_GROWING_CARRIER=
STRIPE_PRICE_FLEET=

# UK postcode -> premises/address lookup — SERVER-ONLY.
# Preferred: Ideal Postcodes (Royal Mail PAF-backed postcode lookup).
IDEAL_POSTCODES_API_KEY=
# Optional fallback if the project already uses getAddress().
GETADDRESS_API_KEY=

# Bank / payment details — SERVER-ONLY (no NEXT_PUBLIC_ prefix).
# These are never embedded in client-side JS bundles.
# Invoice display values come from the company_settings table instead.
COMPANY_BANK_ACCOUNT_NAME=
COMPANY_BANK_SORT_CODE=
COMPANY_BANK_ACCOUNT_NUMBER=
COMPANY_PAYPAL_EMAIL=
